   "source": [
    "def choose_sort(arr: list):\n",
    "    new_arr = []\n",
    "    while arr:\n",
    "        min_el = min(arr)\n",
    "        new_arr.append(min_el)\n",
    "        arr.remove(min_el)\n",
    "\n",
    "    return new_arr\n",
    "\n",
    "print(choose_sort([1, 5, 3, 8, 5]))\n"
   ]
  }
 ],
